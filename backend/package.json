{
  "name": "university-appointment-system-backend",
  "version": "1.0.0",
  "description": "Smart Lecturer Appointment Management System - Backend API",
  "main": "index.js",
  "type": "module",
"scripts": {
  "start": "node index.js",
  "dev": "node --watch index.js",
  "seed": "node scripts/seed.js",
  "test": "node scripts/test-api.js",
  "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
  "test:bdd": "cucumber-js"
},
"jest": {
  "testEnvironment": "node",
  "transform": {},
  "testMatch": ["**/tests/**/*.test.js"],
  "testTimeout": 60000,
  "coverageProvider": "v8",
  "collectCoverageFrom": ["controllers/**/*.js", "utils/**/*.js", "middleware/**/*.js"]
},
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.3.2"
  }
}
