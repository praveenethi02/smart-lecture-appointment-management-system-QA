            "body": {
              "mode": "raw",
              "raw": "{\n  \"availabilityId\": \"{{slotId}}\",\n  \"reason\": \"Final year project review\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
