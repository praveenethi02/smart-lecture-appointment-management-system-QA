    {
      "name": "3. Availability & Booking",
      "item": [
        {
          "name": "TC-API-07 Lecturer creates a future slot -> 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Random future date + hour so re-runs never overlap an existing slot",
                  "      const days = 30 + Math.floor(Math.random() * 300);",
                  "      const date = new Date(Date.now() + days * 86400000).toISOString().slice(0, 10);",
                  "      const hour = 8 + Math.floor(Math.random() * 9);",
                  "      const minute = Math.random() < 0.5 ? \"00\" : \"30\";",
                  "      const pad = (n) => String(n).padStart(2, \"0\");",
                  "      pm.collectionVariables.set(\"slotDate\", date);",
                  "      pm.collectionVariables.set(\"slotStart\", pad(hour) + \":\" + minute);",
                  "      pm.collectionVariables.set(\"slotEnd\", pad(hour) + \":\" + (minute === \"00\" ? \"20\" : \"50\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "      const body = pm.response.json();",
                  "      pm.test(\"success is true\", () => pm.expect(body.success).to.eql(true));",
                  "      pm.test(\"Slot is available with the requested date\", () => {",
                  "        pm.expect(body.slot.status).to.eql(\"available\");",
                  "        pm.expect(body.slot.date).to.eql(pm.collectionVariables.get(\"slotDate\"));",
                  "      });",
                  "      pm.collectionVariables.set(\"slotId\", body.slot._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "availability"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lecturerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{slotDate}}\",\n  \"startTime\": \"{{slotStart}}\",\n  \"endTime\": \"{{slotEnd}}\",\n  \"location\": \"Room 304\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "TC-API-08 Student books the slot -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "      const body = pm.response.json();",
                  "      pm.test(\"success is true\", () => pm.expect(body.success).to.eql(true));",
                  "      pm.test(\"Appointment has an id and is not cancelled\", () => {",
                  "        pm.expect(body.appointment._id).to.be.a(\"string\");",
                  "        pm.expect(body.appointment.status).to.not.eql(\"cancelled\");",
                  "      });",
                  "      pm.collectionVariables.set(\"appointmentId\", body.appointment._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments",
